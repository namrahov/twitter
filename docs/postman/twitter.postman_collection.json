{
  "info": {
    "name": "Twitter - fan-out demo",
    "description": "Ali posts; Veli and Nigar follow Ali, so the tweet should appear in their home timelines. User ids are collection variables; change them if you recreate the users.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "baseUrl2", "value": "http://localhost:8081" },
    { "key": "aliId", "value": "117404340594933760" },
    { "key": "veliId", "value": "117404341194719232" },
    { "key": "nigarId", "value": "117404341446377472" },
    { "key": "postId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Ali posts a tweet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [ "// Remember the new tweet's id for the edit and delete requests (8, 9).", "pm.collectionVariables.set('postId', pm.response.json().id);" ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-User-Id", "value": "{{aliId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"Salam, bu mənim ilk tweet-imdir!\"\n}" },
        "url": "{{baseUrl}}/posts"
      }
    },
    {
      "name": "2. Veli's home timeline",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-User-Id", "value": "{{veliId}}" } ],
        "url": "{{baseUrl}}/timeline"
      }
    },
    {
      "name": "3. Nigar's home timeline",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-User-Id", "value": "{{nigarId}}" } ],
        "url": "{{baseUrl}}/timeline"
      }
    },
    {
      "name": "4. Ali's followers",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/{{aliId}}/followers"
      }
    },
    {
      "name": "5. Ali's profile posts",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/{{aliId}}/posts"
      }
    },
    {
      "name": "6. L1 (Caffeine) cache of instance 1",
      "request": {
        "method": "GET",
        "description": "What this instance holds in its in-process cache. Read a timeline first (request 2), then call this.",
        "url": "{{baseUrl}}/admin/cache/l1?limit=50"
      }
    },
    {
      "name": "7. L1 (Caffeine) cache of instance 2",
      "request": {
        "method": "GET",
        "description": "Same for a second instance (start it with SERVER_PORT=8081). Each instance has its own L1, so the two can differ.",
        "url": "{{baseUrl2}}/admin/cache/l1?limit=50"
      }
    },
    {
      "name": "8. Ali edits his tweet",
      "request": {
        "method": "PUT",
        "description": "Edits the tweet created by request 1 ({{postId}}). Only the author may; others get 403. Read a timeline (2) afterwards: new text, editedAt set.",
        "header": [
          { "key": "X-User-Id", "value": "{{aliId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"Salam, bu tweet redaktə olundu!\"\n}" },
        "url": "{{baseUrl}}/posts/{{postId}}"
      }
    },
    {
      "name": "9. Ali deletes his tweet",
      "request": {
        "method": "DELETE",
        "description": "Deletes the tweet created by request 1 ({{postId}}): 204. It disappears from Veli's and Nigar's timelines.",
        "header": [ { "key": "X-User-Id", "value": "{{aliId}}" } ],
        "url": "{{baseUrl}}/posts/{{postId}}"
      }
    }
  ]
}
